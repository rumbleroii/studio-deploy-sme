generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

enum Role {
  viewer
  editor
  admin
}

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  supabaseUserId String    @unique
  email          String    @unique
  role           Role      @default(viewer)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  projects       Project[] @relation("CreatedBy")

  @@map("users")
}

enum ObjectiveSource {
  text
  upload
}

model Project {
  id                    String          @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  researchObjectiveText String
  objectiveSource       ObjectiveSource @default(text)
  sandboxId             String?
  claudeSessionId       String?
  createdById           String          @db.ObjectId
  createdBy             User            @relation("CreatedBy", fields: [createdById], references: [id])
  messages              ProjectMessage[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("projects")
}

enum MessageRole {
  user
  assistant
}

enum MessageStatus {
  streaming
  complete
  error
}

model ProjectMessage {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  projectId String        @db.ObjectId
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  runId     String?       // Links assistant msg to a run
  status    MessageStatus @default(complete)
  streamSeq Int           @default(0) // Last persisted seq for incremental updates
  error     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("project_messages")
}

