{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-4-5",
  "default_agent": "build",
  "plugin": ["oh-my-opencode"],
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "allow",
    "skill": {
      "survey-generation": "allow",
      "survey-hosted": "allow",
      "*": "allow"
    }
  }
}
