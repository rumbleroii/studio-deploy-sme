// This file points to the root Prisma schema
// The actual schema is at: ../../../../prisma/schema.prisma
// This allows the survey-app to use the same Prisma client as the main app

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

enum SurveyStatus {
  incomplete
  complete
  terminated
}

model SurveyResponse {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  surveyId     String        // Survey identifier
  projectId    String        @db.ObjectId
  respondentId String        // Unique ID for this respondent
  responses    Json          // Array of {questionId, value, answeredAt}
  status       SurveyStatus  @default(incomplete)
  metadata     Json?         // Optional: {startedAt, completedAt, deviceInfo, etc}
  submittedAt  DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([surveyId])
  @@index([projectId])
  @@index([respondentId])
  @@index([status])
  @@map("survey_responses")
}

