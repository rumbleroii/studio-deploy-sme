{
	"name": "studio-agent-worker",
	"main": "src/index.ts",
	"compatibility_date": "2024-12-01",
	"account_id": "573d1b2ea922ae79ad5277bfa9df4aa7",
	"workers_dev": true,
	"routes": [
		{
			"pattern": "*.metaforms-sandbox.com/*",
			"zone_name": "metaforms-sandbox.com"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "Sandbox",
				"class_name": "Sandbox"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Sandbox"]
		}
	],
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./Dockerfile",
			"instance_type": "standard-2", // Changed from "lite" - Next.js dev server needs more resources
			"max_instances": 8
		}
	],
	"observability": {
		"enabled": true
	}
}
