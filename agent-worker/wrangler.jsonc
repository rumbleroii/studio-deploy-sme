{
	"name": "studio-agent-worker",
	"main": "src/index.ts",
	"compatibility_date": "2024-12-01",
	"durable_objects": {
		"bindings": [
			{
				"name": "Sandbox",
				"class_name": "Sandbox"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_classes": ["Sandbox"]
		}
	],
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./Dockerfile",
			"instance_type": "lite",
			"max_instances": 10
		}
	]
}
