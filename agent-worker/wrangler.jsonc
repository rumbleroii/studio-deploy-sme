{
	"name": "studio-agent-worker",
	"main": "src/index.ts",
	"compatibility_date": "2024-12-01",
	"account_id": "573d1b2ea922ae79ad5277bfa9df4aa7",
	"workers_dev": true,
		"vars": {
		"PREVIEW_DOMAIN": "metaforms-sandbox.com",
		"R2_ENDPOINT": "https://573d1b2ea922ae79ad5277bfa9df4aa7.r2.cloudflarestorage.com",
		"R2_BUCKET_NAME": "studio-bucket"
	},
	"routes": [
		{
			"pattern": "*.metaforms-sandbox.com/*",
			"zone_name": "metaforms-sandbox.com"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "Sandbox",
				"class_name": "Sandbox"
			}
		]
	},
	"r2_buckets": [
		{
			"binding": "DATA_BUCKET",
			"bucket_name": "studio-bucket"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Sandbox"]
		}
	],
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./Dockerfile",
			"instance_type": "standard-4",
			"max_instances": 10
		}
	],
	"observability": {
		"enabled": true
	}
}
